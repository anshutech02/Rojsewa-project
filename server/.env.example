# ROZSEVA Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rozseva

# JWT
JWT_SECRET=rozseva_jwt_secret_key_change_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=rozseva_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Twilio WhatsApp Integration (Optional: falls back to console logging in development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
